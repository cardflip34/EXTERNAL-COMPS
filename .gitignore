# NEVER publish comp-store dumps, evidence, cookies, tokens, env, logs, buyer/bidder data
*.json
!external_engine/**/*.schema.json
!reports/**/*.json
# small hand-written configs the lane runs on (never data) -- tracked on purpose (were silently ignored until 09-29)
!/fanatics_extra_*.json
!tools/headline_seed_*.json
*.jsonl
*.db
*.duckdb
*.parquet
*.log
*.out
*.bak*
.env*
*cookie*
*token*
*secret*
browser_state/
__pycache__/
*.pyc
.DS_Store
.venv*/

# credentials that live next to synced ops scripts — never let one slip in
.jina_key
*jina_key*
*.key
*.pem
*_token*
